# Supabase — copia esto a .env.local y complétalo con tu proyecto.
# En Supabase: Project Settings → API.

# URL del proyecto (ej. https://abcd1234.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key — segura para el navegador (solo se usa para Realtime)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SECRETA, solo servidor. Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Token de administración: cualquier secreto fuerte. El panel /admin lo pide.
ADMIN_TOKEN=
